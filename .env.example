# Everything here is optional — Ella runs with these defaults if .env is missing.

# Port for the API + UI (always bound to 127.0.0.1)
PORT=4317

# Folders a worker may run in. Separate with ; on Windows and : on macOS/Linux.
# Default: your home folder.
#   Windows: WORKSPACE_ROOTS=D:\Projects;C:\Users\you\code
#   macOS:   WORKSPACE_ROOTS=/Users/you/code
#   Linux:   WORKSPACE_ROOTS=/home/you/code
# WORKSPACE_ROOTS=

# Folder pre-filled in the "New worker" form (default: the first workspace root)
# DEFAULT_CWD=

# What workers may do without asking: default | acceptEdits | plan | bypassPermissions
# Workers run headless and cannot prompt you; denied actions show up as NEEDS YOU.
WORKER_PERMISSION_MODE=acceptEdits

# Workers cooking at the same time (1–8). Each one draws on your plan's usage limit.
MAX_WORKERS=4

# Path to the Claude Code binary, only if auto-detection fails.
#   macOS/Linux: found on PATH as `claude`
#   Windows:     %USERPROFILE%\.local\bin\claude.exe (native installer) or the npm global install
# CLAUDE_BIN=

# Claude Code config folder, only if you moved it (sessions are read from <dir>/projects)
# CLAUDE_CONFIG_DIR=
